# Use ONE of the two providers.
# Option A: OpenAI
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=

# Option B: Google Gemini (free key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash

# If both keys are set, OpenAI is used unless you force one:
# STUDYSPOT_PROVIDER=gemini

STUDYSPOT_USER=demo.student
# STUDYSPOT_DB=data/studyspot.db
# STUDYSPOT_NOW=2026-10-22T10:00:00+03:00
